<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zach.iterm2-fork-update</string>
    <key>ProgramArguments</key>
    <!-- run-update, not /bin/zsh: a bare launchd shell cannot read ~/Documents (run-update/main.swift). -->
    <array>
        <string>__HOME__/Documents/iTerm2-builds/bin/run-update</string>
    </array>
    <!-- At load too (login, install.sh). It runs during quiet hours as well (Zach 2026-11-15):
         quiet hours keep this agent loaded. update.sh exits at once when the newest nightly is
         already built. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <!-- Standard, not Background (Zach 2026-11-16: "let any wow builds run fast"): launchd's
         Background clamp holds the whole build on the efficiency cores and nothing can lift it
         from outside (11-16: 10.5 h). Nice 10 keeps WoW and the sessions ahead; mac-heavy-guard
         rule 6 keeps it off background QoS while WoW runs. -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardErrorPath</key>
    <string>__HOME__/Documents/iTerm2-builds/logs/update-agent.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Documents/iTerm2-builds/logs/update-agent.log</string>
</dict>
</plist>
